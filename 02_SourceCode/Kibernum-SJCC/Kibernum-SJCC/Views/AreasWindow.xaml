<Window x:Class="Kibernum_SJCC.Views.AreasWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuración de Áreas" Height="400" Width="450" WindowStartupLocation="CenterOwner" Icon="/Views/id-card-clip-alt_9856425.png">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <GroupBox Header="Detalle del Área" Margin="0,0,0,10" Padding="10">
            <StackPanel>
                <Label Content="Nombre del Área:"/>
                <TextBox Text="{Binding NombreArea, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Limpiar" 
                            Width="80" 
                            Height="25" 
                            Margin="0,0,10,0" 
                            Command="{Binding LimpiarCommand}" 
                            Click="btnLimpiar_Click"/>
                    <Button Content="Borrar" 
                            Width="80" 
                            Height="25" 
                            Margin="0,0,10,0" 
                            Command="{Binding BorrarCommand}" 
                            Click="btnBorrar_Click"/>
                    <Button Content="Guardar" 
                            Command="{Binding GuardarCommand}"
                            Background="{StaticResource VerdeKibernum}" 
                            Foreground="White" 
                            FontWeight="Bold"
                            Width="120" Height="30"
                            Click="btnGuardar_Click"
                            />       
                </StackPanel>
            </StackPanel>
        </GroupBox>
        
        <GroupBox Header="Áreas Existentes" Grid.Row="1">
            <DataGrid ItemsSource="{Binding Areas}" 
                      SelectedItem="{Binding AreaSeleccionada}" 
                      AutoGenerateColumns="False" 
                      IsReadOnly="True" 
                      SelectionMode="Single"
                      Margin="5">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding IdArea}" Width="50"/>
                    <DataGridTextColumn Header="Nombre del Área" Binding="{Binding Nombre}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>
    </Grid>
</Window>